{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz",
    "description": "MCQ Quizzes attached to Courses and Lessons"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "passingScore": {
      "type": "integer",
      "default": 70,
      "min": 0,
      "max": 100
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "quizzes"
    },
    "lesson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lesson.lesson",
      "inversedBy": "quizzes"
    },
    "questions": {
      "type": "component",
      "repeatable": true,
      "component": "quiz.question"
    },
    "submissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz-submission.quiz-submission",
      "mappedBy": "quiz"
    }
  }
}
