{
  "kind": "collectionType",
  "collectionName": "enrollments",
  "info": {
    "singularName": "enrollment",
    "pluralName": "enrollments",
    "displayName": "Enrollment",
    "description": "Student enrollment in courses with tracked progress percentage"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "enrolledAt": {
      "type": "datetime",
      "required": true
    },
    "progressPercentage": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 100
    },
    "enrollmentStatus": {
      "type": "enumeration",
      "default": "active",
      "enum": [
        "active",
        "completed",
        "dropped"
      ]
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "enrollments"
    },
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
