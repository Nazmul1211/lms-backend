{
  "kind": "collectionType",
  "collectionName": "quiz_submissions",
  "info": {
    "singularName": "quiz-submission",
    "pluralName": "quiz-submissions",
    "displayName": "QuizSubmission",
    "description": "Student quiz attempts and auto-graded results"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "score": {
      "type": "integer",
      "required": true
    },
    "totalQuestions": {
      "type": "integer",
      "required": true
    },
    "correctAnswersCount": {
      "type": "integer",
      "required": true
    },
    "passed": {
      "type": "boolean",
      "default": false
    },
    "submittedAnswers": {
      "type": "json",
      "required": true
    },
    "submittedAt": {
      "type": "datetime",
      "required": true
    },
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "submissions"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course"
    }
  }
}
